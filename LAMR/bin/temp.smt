(set-logic QF_BV)
(set-option :produce-models true)
(declare-const xmin_1 (_ BitVec 16))
(declare-const xmax_1 (_ BitVec 16))
(declare-const ymin_1 (_ BitVec 16))
(declare-const ymax_1 (_ BitVec 16))
(assert (and (bvsle #x0001 xmin_1) (bvsle xmax_1 #x0010) (bvsle xmin_1 xmax_1)))
(assert (and (bvsle #x0001 ymin_1) (bvsle ymax_1 #x000f) (bvsle ymin_1 ymax_1)))
(assert (and (bvsge xmax_1 (bvadd xmin_1 #x0000)) (bvsle xmax_1 (bvadd xmin_1 #x0001))))
(assert (and (bvsge ymax_1 (bvadd ymin_1 #x0000)) (bvsle ymax_1 (bvadd ymin_1 #x0001))))
(assert (= (bvadd (bvsub xmax_1 xmin_1) (bvsub ymax_1 ymin_1)) #x0001))
(declare-const xmin_2 (_ BitVec 16))
(declare-const xmax_2 (_ BitVec 16))
(declare-const ymin_2 (_ BitVec 16))
(declare-const ymax_2 (_ BitVec 16))
(assert (and (bvsle #x0001 xmin_2) (bvsle xmax_2 #x0010) (bvsle xmin_2 xmax_2)))
(assert (and (bvsle #x0001 ymin_2) (bvsle ymax_2 #x000f) (bvsle ymin_2 ymax_2)))
(assert (and (bvsge xmax_2 (bvadd xmin_2 #x0001)) (bvsle xmax_2 (bvadd xmin_2 #x0002))))
(assert (and (bvsge ymax_2 (bvadd ymin_2 #x0001)) (bvsle ymax_2 (bvadd ymin_2 #x0002))))
(assert (= (bvadd (bvsub xmax_2 xmin_2) (bvsub ymax_2 ymin_2)) #x0003))
(declare-const xmin_3 (_ BitVec 16))
(declare-const xmax_3 (_ BitVec 16))
(declare-const ymin_3 (_ BitVec 16))
(declare-const ymax_3 (_ BitVec 16))
(assert (and (bvsle #x0001 xmin_3) (bvsle xmax_3 #x0010) (bvsle xmin_3 xmax_3)))
(assert (and (bvsle #x0001 ymin_3) (bvsle ymax_3 #x000f) (bvsle ymin_3 ymax_3)))
(assert (and (bvsge xmax_3 (bvadd xmin_3 #x0002)) (bvsle xmax_3 (bvadd xmin_3 #x0003))))
(assert (and (bvsge ymax_3 (bvadd ymin_3 #x0002)) (bvsle ymax_3 (bvadd ymin_3 #x0003))))
(assert (= (bvadd (bvsub xmax_3 xmin_3) (bvsub ymax_3 ymin_3)) #x0005))
(declare-const xmin_4 (_ BitVec 16))
(declare-const xmax_4 (_ BitVec 16))
(declare-const ymin_4 (_ BitVec 16))
(declare-const ymax_4 (_ BitVec 16))
(assert (and (bvsle #x0001 xmin_4) (bvsle xmax_4 #x0010) (bvsle xmin_4 xmax_4)))
(assert (and (bvsle #x0001 ymin_4) (bvsle ymax_4 #x000f) (bvsle ymin_4 ymax_4)))
(assert (and (bvsge xmax_4 (bvadd xmin_4 #x0003)) (bvsle xmax_4 (bvadd xmin_4 #x0004))))
(assert (and (bvsge ymax_4 (bvadd ymin_4 #x0003)) (bvsle ymax_4 (bvadd ymin_4 #x0004))))
(assert (= (bvadd (bvsub xmax_4 xmin_4) (bvsub ymax_4 ymin_4)) #x0007))
(declare-const xmin_5 (_ BitVec 16))
(declare-const xmax_5 (_ BitVec 16))
(declare-const ymin_5 (_ BitVec 16))
(declare-const ymax_5 (_ BitVec 16))
(assert (and (bvsle #x0001 xmin_5) (bvsle xmax_5 #x0010) (bvsle xmin_5 xmax_5)))
(assert (and (bvsle #x0001 ymin_5) (bvsle ymax_5 #x000f) (bvsle ymin_5 ymax_5)))
(assert (and (bvsge xmax_5 (bvadd xmin_5 #x0004)) (bvsle xmax_5 (bvadd xmin_5 #x0005))))
(assert (and (bvsge ymax_5 (bvadd ymin_5 #x0004)) (bvsle ymax_5 (bvadd ymin_5 #x0005))))
(assert (= (bvadd (bvsub xmax_5 xmin_5) (bvsub ymax_5 ymin_5)) #x0009))
(declare-const xmin_6 (_ BitVec 16))
(declare-const xmax_6 (_ BitVec 16))
(declare-const ymin_6 (_ BitVec 16))
(declare-const ymax_6 (_ BitVec 16))
(assert (and (bvsle #x0001 xmin_6) (bvsle xmax_6 #x0010) (bvsle xmin_6 xmax_6)))
(assert (and (bvsle #x0001 ymin_6) (bvsle ymax_6 #x000f) (bvsle ymin_6 ymax_6)))
(assert (and (bvsge xmax_6 (bvadd xmin_6 #x0005)) (bvsle xmax_6 (bvadd xmin_6 #x0006))))
(assert (and (bvsge ymax_6 (bvadd ymin_6 #x0005)) (bvsle ymax_6 (bvadd ymin_6 #x0006))))
(assert (= (bvadd (bvsub xmax_6 xmin_6) (bvsub ymax_6 ymin_6)) #x000b))
(declare-const xmin_7 (_ BitVec 16))
(declare-const xmax_7 (_ BitVec 16))
(declare-const ymin_7 (_ BitVec 16))
(declare-const ymax_7 (_ BitVec 16))
(assert (and (bvsle #x0001 xmin_7) (bvsle xmax_7 #x0010) (bvsle xmin_7 xmax_7)))
(assert (and (bvsle #x0001 ymin_7) (bvsle ymax_7 #x000f) (bvsle ymin_7 ymax_7)))
(assert (and (bvsge xmax_7 (bvadd xmin_7 #x0006)) (bvsle xmax_7 (bvadd xmin_7 #x0007))))
(assert (and (bvsge ymax_7 (bvadd ymin_7 #x0006)) (bvsle ymax_7 (bvadd ymin_7 #x0007))))
(assert (= (bvadd (bvsub xmax_7 xmin_7) (bvsub ymax_7 ymin_7)) #x000d))
(declare-const xmin_8 (_ BitVec 16))
(declare-const xmax_8 (_ BitVec 16))
(declare-const ymin_8 (_ BitVec 16))
(declare-const ymax_8 (_ BitVec 16))
(assert (and (bvsle #x0001 xmin_8) (bvsle xmax_8 #x0010) (bvsle xmin_8 xmax_8)))
(assert (and (bvsle #x0001 ymin_8) (bvsle ymax_8 #x000f) (bvsle ymin_8 ymax_8)))
(assert (and (bvsge xmax_8 (bvadd xmin_8 #x0007)) (bvsle xmax_8 (bvadd xmin_8 #x0008))))
(assert (and (bvsge ymax_8 (bvadd ymin_8 #x0007)) (bvsle ymax_8 (bvadd ymin_8 #x0008))))
(assert (= (bvadd (bvsub xmax_8 xmin_8) (bvsub ymax_8 ymin_8)) #x000f))
(assert (or (bvslt ymax_1 ymin_2) (bvslt ymax_2 ymin_1) (bvslt xmax_2 xmin_1) (bvslt xmax_1 xmin_2)))
(assert (or (bvslt ymax_1 ymin_3) (bvslt ymax_3 ymin_1) (bvslt xmax_3 xmin_1) (bvslt xmax_1 xmin_3)))
(assert (or (bvslt ymax_1 ymin_4) (bvslt ymax_4 ymin_1) (bvslt xmax_4 xmin_1) (bvslt xmax_1 xmin_4)))
(assert (or (bvslt ymax_1 ymin_5) (bvslt ymax_5 ymin_1) (bvslt xmax_5 xmin_1) (bvslt xmax_1 xmin_5)))
(assert (or (bvslt ymax_1 ymin_6) (bvslt ymax_6 ymin_1) (bvslt xmax_6 xmin_1) (bvslt xmax_1 xmin_6)))
(assert (or (bvslt ymax_1 ymin_7) (bvslt ymax_7 ymin_1) (bvslt xmax_7 xmin_1) (bvslt xmax_1 xmin_7)))
(assert (or (bvslt ymax_1 ymin_8) (bvslt ymax_8 ymin_1) (bvslt xmax_8 xmin_1) (bvslt xmax_1 xmin_8)))
(assert (or (bvslt ymax_2 ymin_3) (bvslt ymax_3 ymin_2) (bvslt xmax_3 xmin_2) (bvslt xmax_2 xmin_3)))
(assert (or (bvslt ymax_2 ymin_4) (bvslt ymax_4 ymin_2) (bvslt xmax_4 xmin_2) (bvslt xmax_2 xmin_4)))
(assert (or (bvslt ymax_2 ymin_5) (bvslt ymax_5 ymin_2) (bvslt xmax_5 xmin_2) (bvslt xmax_2 xmin_5)))
(assert (or (bvslt ymax_2 ymin_6) (bvslt ymax_6 ymin_2) (bvslt xmax_6 xmin_2) (bvslt xmax_2 xmin_6)))
(assert (or (bvslt ymax_2 ymin_7) (bvslt ymax_7 ymin_2) (bvslt xmax_7 xmin_2) (bvslt xmax_2 xmin_7)))
(assert (or (bvslt ymax_2 ymin_8) (bvslt ymax_8 ymin_2) (bvslt xmax_8 xmin_2) (bvslt xmax_2 xmin_8)))
(assert (or (bvslt ymax_3 ymin_4) (bvslt ymax_4 ymin_3) (bvslt xmax_4 xmin_3) (bvslt xmax_3 xmin_4)))
(assert (or (bvslt ymax_3 ymin_5) (bvslt ymax_5 ymin_3) (bvslt xmax_5 xmin_3) (bvslt xmax_3 xmin_5)))
(assert (or (bvslt ymax_3 ymin_6) (bvslt ymax_6 ymin_3) (bvslt xmax_6 xmin_3) (bvslt xmax_3 xmin_6)))
(assert (or (bvslt ymax_3 ymin_7) (bvslt ymax_7 ymin_3) (bvslt xmax_7 xmin_3) (bvslt xmax_3 xmin_7)))
(assert (or (bvslt ymax_3 ymin_8) (bvslt ymax_8 ymin_3) (bvslt xmax_8 xmin_3) (bvslt xmax_3 xmin_8)))
(assert (or (bvslt ymax_4 ymin_5) (bvslt ymax_5 ymin_4) (bvslt xmax_5 xmin_4) (bvslt xmax_4 xmin_5)))
(assert (or (bvslt ymax_4 ymin_6) (bvslt ymax_6 ymin_4) (bvslt xmax_6 xmin_4) (bvslt xmax_4 xmin_6)))
(assert (or (bvslt ymax_4 ymin_7) (bvslt ymax_7 ymin_4) (bvslt xmax_7 xmin_4) (bvslt xmax_4 xmin_7)))
(assert (or (bvslt ymax_4 ymin_8) (bvslt ymax_8 ymin_4) (bvslt xmax_8 xmin_4) (bvslt xmax_4 xmin_8)))
(assert (or (bvslt ymax_5 ymin_6) (bvslt ymax_6 ymin_5) (bvslt xmax_6 xmin_5) (bvslt xmax_5 xmin_6)))
(assert (or (bvslt ymax_5 ymin_7) (bvslt ymax_7 ymin_5) (bvslt xmax_7 xmin_5) (bvslt xmax_5 xmin_7)))
(assert (or (bvslt ymax_5 ymin_8) (bvslt ymax_8 ymin_5) (bvslt xmax_8 xmin_5) (bvslt xmax_5 xmin_8)))
(assert (or (bvslt ymax_6 ymin_7) (bvslt ymax_7 ymin_6) (bvslt xmax_7 xmin_6) (bvslt xmax_6 xmin_7)))
(assert (or (bvslt ymax_6 ymin_8) (bvslt ymax_8 ymin_6) (bvslt xmax_8 xmin_6) (bvslt xmax_6 xmin_8)))
(assert (or (bvslt ymax_7 ymin_8) (bvslt ymax_8 ymin_7) (bvslt xmax_8 xmin_7) (bvslt xmax_7 xmin_8)))
(check-sat)
(get-model)